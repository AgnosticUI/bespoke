   DaisyUI Theme — Generated by Bespoke Design Pipeline
   Layout: {{meta.layout_id}} | Typography: {{meta.typography_id}} | Palette: {{meta.palette_id}}
   Niche: {{meta.niche}} ({{meta.app_type}})
   Generated: {{now}}

   Usage:
     <html data-theme="bespoke">        (light mode)
     <html data-theme="bespoke-dark">   (dark mode)
   ========================================================================== */

{{{fonts.cssImport}}}

/* ── Light Theme ── */
[data-theme="bespoke"] {
  color-scheme: light;

  /* Brand */
  --color-primary: {{colors.primary.hex}};
  --color-primary-content: {{contrastHex colors.primary.hex}};
  --color-secondary: {{colors.secondary.hex}};
  --color-secondary-content: {{contrastHex colors.secondary.hex}};
  --color-accent: {{colors.accent.hex}};
  --color-accent-content: {{contrastHex colors.accent.hex}};

  /* Neutral */
  --color-neutral: {{colors.foreground.hex}};
  --color-neutral-content: {{colors.background.hex}};

  /* Base surfaces */
  --color-base-100: {{colors.background.hex}};
  --color-base-200: {{colors.muted.hex}};
  --color-base-300: {{colors.border.hex}};
  --color-base-content: {{colors.foreground.hex}};

  /* Semantic status */
  --color-info: {{colors.primary.hex}};
  --color-info-content: {{contrastHex colors.primary.hex}};
  --color-success: {{colors.success.hex}};
  --color-success-content: {{contrastHex colors.success.hex}};
  --color-warning: {{colors.warning.hex}};
  --color-warning-content: {{contrastHex colors.warning.hex}};
  --color-error: {{colors.destructive.hex}};
  --color-error-content: {{contrastHex colors.destructive.hex}};

  /* Structure */
  --radius-selector: {{rem radius.lg}};
  --radius-field: {{rem radius.sm}};
  --radius-box: {{rem radius.md}};
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 1;
  --noise: 0;
}

/* ── Dark Theme ── */
[data-theme="bespoke-dark"] {
  color-scheme: dark;

  /* Brand */
  --color-primary: {{darkColors.primary.hex}};
  --color-primary-content: {{contrastHex darkColors.primary.hex}};
  --color-secondary: {{darkColors.secondary.hex}};
  --color-secondary-content: {{contrastHex darkColors.secondary.hex}};
  --color-accent: {{darkColors.accent.hex}};
  --color-accent-content: {{contrastHex darkColors.accent.hex}};

  /* Neutral */
  --color-neutral: {{darkColors.foreground.hex}};
  --color-neutral-content: {{darkColors.background.hex}};

  /* Base surfaces */
  --color-base-100: {{darkColors.background.hex}};
  --color-base-200: {{darkColors.muted.hex}};
  --color-base-300: {{darkColors.border.hex}};
  --color-base-content: {{darkColors.foreground.hex}};

  /* Semantic status */
  --color-info: {{darkColors.primary.hex}};
  --color-info-content: {{contrastHex darkColors.primary.hex}};
  --color-success: {{darkColors.success.hex}};
  --color-success-content: {{contrastHex darkColors.success.hex}};
  --color-warning: {{darkColors.warning.hex}};
  --color-warning-content: {{contrastHex darkColors.warning.hex}};
  --color-error: {{darkColors.destructive.hex}};
  --color-error-content: {{contrastHex darkColors.destructive.hex}};

  /* Structure */
  --radius-selector: {{rem radius.lg}};
  --radius-field: {{rem radius.sm}};
  --radius-box: {{rem radius.md}};
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 1;
  --noise: 0;
}

/* ── Typography ── */
body {
  font-family: '{{fonts.body}}', system-ui, sans-serif;
}

h1, h2, h3, h4, h5, h6 {
  font-family: '{{fonts.heading}}', system-ui, sans-serif;
}

code, pre, kbd, samp {
  font-family: '{{fonts.mono}}', ui-monospace, monospace;
}
