/* ==========================================================================
   shadcn/ui Design Tokens — Generated by Bespoke Design Pipeline
   Layout: {{meta.layout_id}} | Typography: {{meta.typography_id}} | Palette: {{meta.palette_id}}
   Niche: {{meta.niche}} ({{meta.app_type}})
   Generated: {{now}}
   ========================================================================== */

{{{fonts.cssImport}}}

:root {
  /* ── Brand Colors (HSL for shadcn/ui) ── */
  --background: {{hsl colors.background.hex}};
  --foreground: {{hsl colors.foreground.hex}};

  --card: {{hsl colors.card.hex}};
  --card-foreground: {{hsl colors.cardForeground.hex}};

  --popover: {{hsl colors.card.hex}};
  --popover-foreground: {{hsl colors.cardForeground.hex}};

  --primary: {{hsl colors.primary.hex}};
  --primary-foreground: {{contrastText colors.primary.hex}};

  --secondary: {{hsl colors.secondary.hex}};
  --secondary-foreground: {{contrastText colors.secondary.hex}};

  --muted: {{hsl colors.muted.hex}};
  --muted-foreground: {{hsl colors.mutedForeground.hex}};

  --accent: {{hsl colors.accent.hex}};
  --accent-foreground: {{contrastText colors.accent.hex}};

  --destructive: {{hsl colors.destructive.hex}};
  --destructive-foreground: {{contrastText colors.destructive.hex}};

  --border: {{hsl colors.border.hex}};
  --input: {{hsl colors.input.hex}};
  --ring: {{hsl colors.ring.hex}};

  /* ── Semantic Status Colors ── */
  --success: {{hsl colors.success.hex}};
  --success-foreground: {{contrastText colors.success.hex}};
  --warning: {{hsl colors.warning.hex}};
  --warning-foreground: {{contrastText colors.warning.hex}};

  /* ── Typography ── */
  --font-heading: '{{fonts.heading}}', sans-serif;
  --font-body: '{{fonts.body}}', sans-serif;
  --font-mono: '{{fonts.mono}}', monospace;

  /* ── Border Radius ── */
  --radius: {{rem radius.md}};
  --radius-sm: {{rem radius.sm}};
  --radius-lg: {{rem radius.lg}};
  --radius-xl: {{rem radius.xl}};

  /* ── Shadows ── */
  --shadow-sm: {{shadows.sm}};
  --shadow-md: {{shadows.md}};
  --shadow-lg: {{shadows.lg}};
}

/* ── Dark Mode: OS preference ── */
@media (prefers-color-scheme: dark) {
  :root {
    --background: {{hsl darkColors.background.hex}};
    --foreground: {{hsl darkColors.foreground.hex}};

    --card: {{hsl darkColors.card.hex}};
    --card-foreground: {{hsl darkColors.cardForeground.hex}};

    --popover: {{hsl darkColors.popover.hex}};
    --popover-foreground: {{hsl darkColors.popoverForeground.hex}};

    --primary: {{hsl darkColors.primary.hex}};
    --primary-foreground: {{hsl darkColors.primaryForeground.hex}};

    --secondary: {{hsl darkColors.secondary.hex}};
    --secondary-foreground: {{hsl darkColors.secondaryForeground.hex}};

    --muted: {{hsl darkColors.muted.hex}};
    --muted-foreground: {{hsl darkColors.mutedForeground.hex}};

    --accent: {{hsl darkColors.accent.hex}};
    --accent-foreground: {{hsl darkColors.accentForeground.hex}};

    --destructive: {{hsl darkColors.destructive.hex}};
    --destructive-foreground: {{hsl darkColors.destructiveForeground.hex}};

    --border: {{hsl darkColors.border.hex}};
    --input: {{hsl darkColors.input.hex}};
    --ring: {{hsl darkColors.ring.hex}};

    --success: {{hsl darkColors.success.hex}};
    --success-foreground: {{hsl darkColors.successForeground.hex}};
    --warning: {{hsl darkColors.warning.hex}};
    --warning-foreground: {{hsl darkColors.warningForeground.hex}};
  }
}

/* ── Dark Mode: explicit override ── */
[data-theme="dark"],
.dark {
  --background: {{hsl darkColors.background.hex}};
  --foreground: {{hsl darkColors.foreground.hex}};

  --card: {{hsl darkColors.card.hex}};
  --card-foreground: {{hsl darkColors.cardForeground.hex}};

  --popover: {{hsl darkColors.popover.hex}};
  --popover-foreground: {{hsl darkColors.popoverForeground.hex}};

  --primary: {{hsl darkColors.primary.hex}};
  --primary-foreground: {{hsl darkColors.primaryForeground.hex}};

  --secondary: {{hsl darkColors.secondary.hex}};
  --secondary-foreground: {{hsl darkColors.secondaryForeground.hex}};

  --muted: {{hsl darkColors.muted.hex}};
  --muted-foreground: {{hsl darkColors.mutedForeground.hex}};

  --accent: {{hsl darkColors.accent.hex}};
  --accent-foreground: {{hsl darkColors.accentForeground.hex}};

  --destructive: {{hsl darkColors.destructive.hex}};
  --destructive-foreground: {{hsl darkColors.destructiveForeground.hex}};

  --border: {{hsl darkColors.border.hex}};
  --input: {{hsl darkColors.input.hex}};
  --ring: {{hsl darkColors.ring.hex}};

  --success: {{hsl darkColors.success.hex}};
  --success-foreground: {{hsl darkColors.successForeground.hex}};
  --warning: {{hsl darkColors.warning.hex}};
  --warning-foreground: {{hsl darkColors.warningForeground.hex}};
}

@layer base {
  * {
    border-color: hsl(var(--border));
  }

  body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-family: var(--font-body);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
  }

  code, pre, kbd {
    font-family: var(--font-mono);
  }
}
