{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["scripts/utils/*"],
      "@data/*": ["data/*"],
      "@templates/*": ["templates/*"]
    }
  },
  "include": ["scripts/**/*.ts", "templates/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
