    --color-border: {{darkColors.border.hex}};
    --color-muted: {{darkColors.muted.hex}};
    --color-muted-foreground: {{darkColors.mutedForeground.hex}};
    --color-destructive: {{darkColors.destructive.hex}};
    --color-success: {{darkColors.success.hex}};
    --color-warning: {{darkColors.warning.hex}};

    --color-primary-rgb: {{rgb darkColors.primary.hex}};
    --color-secondary-rgb: {{rgb darkColors.secondary.hex}};
    --color-accent-rgb: {{rgb darkColors.accent.hex}};
    --color-background-rgb: {{rgb darkColors.background.hex}};
