:root {
  /* ── Colors: Hex ── */
  --color-primary: {{colors.primary.hex}};
  --color-secondary: {{colors.secondary.hex}};
  --color-accent: {{colors.accent.hex}};
  --color-background: {{colors.background.hex}};
  --color-foreground: {{colors.foreground.hex}};
  --color-border: {{colors.border.hex}};
  --color-muted: {{colors.muted.hex}};
  --color-muted-foreground: {{colors.mutedForeground.hex}};
  --color-destructive: {{colors.destructive.hex}};
  --color-success: {{colors.success.hex}};
  --color-warning: {{colors.warning.hex}};

  /* ── Colors: RGB (space-separated for alpha compositing) ── */
  --color-primary-rgb: {{rgb colors.primary.hex}};
  --color-secondary-rgb: {{rgb colors.secondary.hex}};
  --color-accent-rgb: {{rgb colors.accent.hex}};
  --color-background-rgb: {{rgb colors.background.hex}};
  --color-foreground-rgb: {{rgb colors.foreground.hex}};
  --color-border-rgb: {{rgb colors.border.hex}};

  /* ── Colors: HSL ── */
  --color-primary-hsl: {{hslCss colors.primary.hex}};
  --color-secondary-hsl: {{hslCss colors.secondary.hex}};
  --color-accent-hsl: {{hslCss colors.accent.hex}};
  --color-background-hsl: {{hslCss colors.background.hex}};
  --color-foreground-hsl: {{hslCss colors.foreground.hex}};
  --color-border-hsl: {{hslCss colors.border.hex}};

  /* ── Typography ── */
  --font-heading: '{{fonts.heading}}', sans-serif;
  --font-body: '{{fonts.body}}', sans-serif;
  --font-mono: '{{fonts.mono}}', monospace;

  /* ── Spacing Scale ── */
  --space-xs: {{rem spacing.xs}};
  --space-sm: {{rem spacing.sm}};
  --space-md: {{rem spacing.md}};
  --space-lg: {{rem spacing.lg}};
  --space-xl: {{rem spacing.xl}};
  --space-2xl: {{rem spacing.2xl}};
  --space-3xl: {{rem spacing.3xl}};
  --space-section: {{rem spacing.section}};

  /* ── Border Radius ── */
  --radius-sm: {{rem radius.sm}};
  --radius-md: {{rem radius.md}};
  --radius-lg: {{rem radius.lg}};
  --radius-xl: {{rem radius.xl}};
  --radius-full: {{radius.full}};

  /* ── Shadows ── */
  --shadow-sm: {{shadows.sm}};
  --shadow-md: {{shadows.md}};
  --shadow-lg: {{shadows.lg}};

  /* ── Focus Ring ── */
  --focus-ring: 0 0 0 3px {{focusRing colors.primary.hex}};
}

